# Production Environment Configuration for FlyFile

# Railway deployment URL
VITE_SERVER_URL=https://flyfile-production.up.railway.app

# STUN/TURN Servers for WebRTC
VITE_STUN_SERVER_1=stun:stun.l.google.com:19302
VITE_STUN_SERVER_2=stun:stun1.l.google.com:19302
VITE_TURN_SERVER=turn:openrelay.metered.ca:443
VITE_TURN_USERNAME=openrelayproject
VITE_TURN_CREDENTIAL=openrelayproject

# Production environment
NODE_ENV=production

