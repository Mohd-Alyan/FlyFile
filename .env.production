# Production Environment Configuration for FlyFile

# This will be updated after Railway deployment
VITE_SERVER_URL=https://your-railway-app.railway.app

# Railway will set PORT automatically
PORT=3001
HOST=0.0.0.0

# Production environment
NODE_ENV=production

# CORS origins (will be updated with Netlify URL)
CORS_ORIGINS=https://your-netlify-app.netlify.app

# STUN/TURN Servers for production
VITE_STUN_SERVER_1=stun:stun.l.google.com:19302
VITE_STUN_SERVER_2=stun:stun1.l.google.com:19302
